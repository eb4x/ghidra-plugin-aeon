# Everything below the endianness line, shared by aeonR2.slaspec (big-endian
# data), aeonR2le.slaspec (little-endian data) and aeonR2le_harvard.slaspec
# (little-endian data in its own space). Instructions are big-endian in all
# three: the tokens carry endian=big. Each slaspec defines DATA, the space
# every load and store names.
define alignment=1;

define space ram     type=ram_space     size=4 default;
define space register type=register_space size=4;
@ifdef HARVARD
# Loads and stores (aeonR2le_harvard.slaspec only)
define space data type=ram_space size=4;
@endif
# Special-purpose registers, addressed by index * 4 (see bg.mfspr/bg.mtspr).
define space spr type=ram_space size=4;

define register offset=0x000 size=4 [
  r0  r1  r2  r3  r4  r5  r6  r7  r8  r9  r10 r11 r12 r13 r14 r15
  r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31
];
define register offset=0x100 size=4 [ pc sr ];
# Condition flag and carry are standalone registers, never bit-fields of sr,
# so compare-and-branch reaches the decompiler one p-code op deep.
define register offset=0x120 size=1 [ F CY ];
define register offset=0x200 size=16 [
  v0  v1  v2  v3  v4  v5  v6  v7  v8  v9  v10 v11 v12 v13 v14 v15
  v16 v17 v18 v19 v20 v21 v22 v23 v24 v25 v26 v27 v28 v29 v30 v31
];

@include "aeonR2_pcodeops.sinc"
@include "aeonR2.sinc"
