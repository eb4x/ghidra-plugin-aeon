<?xml version="1.0" encoding="UTF-8"?>
<compiler_spec>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="r1" space="ram" growth="negative"/>
  <returnaddress>
    <register name="r9"/>
  </returnaddress>
  <default_proto>
    <!-- Verified against the vendor gcc (-march=aeonR2): arguments in r3..r8
         then on the stack, result in r3 (r4:r3 for 64 bits: with -mle gcc puts the LOW word in r3 and the high word in r4, for arguments and results alike),
         link register r9, callee-saved r10..r22 (contiguous, deliberately not
         OpenRISC's even-only pattern). r2 is left out of both lists: aeonR2 gcc
         never touches it, which is not evidence that a hand-written callee
         preserves it, and the conservative default is what we want. -->
    <prototype name="__stdcall" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="4"><register name="r3"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="r4"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="r5"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="r6"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="r7"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="r8"/></pentry>
        <pentry minsize="1" maxsize="500" align="4">
          <addr offset="0" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4"><register name="r3"/></pentry>
        <pentry minsize="5" maxsize="8">
          <addr space="join" piece1="r4" piece2="r3"/>
        </pentry>
      </output>
      <unaffected>
        <register name="r0"/>
        <register name="r1"/>
        <register name="r10"/> <register name="r11"/> <register name="r12"/>
        <register name="r13"/> <register name="r14"/> <register name="r15"/>
        <register name="r16"/> <register name="r17"/> <register name="r18"/>
        <register name="r19"/> <register name="r20"/> <register name="r21"/>
        <register name="r22"/>
      </unaffected>
      <killedbycall>
        <register name="r3"/> <register name="r4"/> <register name="r5"/>
        <register name="r6"/> <register name="r7"/> <register name="r8"/>
        <register name="r9"/>
        <register name="r23"/> <register name="r24"/> <register name="r25"/>
        <register name="r26"/> <register name="r27"/> <register name="r28"/>
        <register name="r29"/> <register name="r30"/> <register name="r31"/>
        <register name="F"/> <register name="CY"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>
