<?xml version="1.0" encoding="UTF-8"?>
<processor_spec>
  <properties>
    <!-- Off by default. MStar firmware holds little-endian records of code
         addresses that point just past call instructions. The stock table
         finder turns those into references, and the non-returning-function
         heuristic reads a reference after a call as evidence that the callee
         never returns. On stream 0 it marked nine heavily-used helpers
         non-returning (one with 683 callers), which cut off 270 functions and
         put 1,228 "Subroutine does not return" warnings in the decompilation.
         With it off: no non-returning functions, 3,151 functions, and jump-table
         recovery the same as before. -->
    <property key="Analyzers.Create Address Tables" value="false"/>
    <!-- Addresses are built by movhi + addi/ori and never appear whole in an
         operand, so a scalar operand that happens to fall in mapped memory is a
         number, not a pointer. This turns the Scalar Operand References
         analyzer off, as ARM, MIPS and PowerPC do; AeonAddressAnalyzer
         references the real pairs. Without it, `b.addi r1,r1,-4` showed up as
         a reference to data:0xfffc. -->
    <property key="addressesDoNotAppearDirectlyInCode" value="true"/>
  </properties>
  <programcounter register="pc"/>
  <!-- Instructions are 2, 3 or 4 bytes and may start at any address. -->
  <data_space space="data"/>
  <default_symbols>
    <!-- OpenRISC-style exception vectors, confirmed in sBoot: 0x100 is the
         reset entry, and 0x200/0x300/0x400/0xc00 each start with the same
         handler prologue (fc 21 fe e4 = b.addi r1,r1,-0x11c). They only apply
         to an image based at 0; a module loaded elsewhere has no memory at
         these addresses and Ghidra ignores them. -->
    <symbol name="vector_reset"       address="0x100" entry="true"/>
    <symbol name="vector_bus_error"   address="0x200" entry="true"/>
    <symbol name="vector_data_page"   address="0x300" entry="true"/>
    <symbol name="vector_insn_page"   address="0x400" entry="true"/>
    <symbol name="vector_tick_timer"  address="0x500" entry="true"/>
    <symbol name="vector_alignment"   address="0x600" entry="true"/>
    <symbol name="vector_illegal"     address="0x700" entry="true"/>
    <symbol name="vector_external_int" address="0x800" entry="true"/>
    <symbol name="vector_dtlb_miss"   address="0x900" entry="true"/>
    <symbol name="vector_itlb_miss"   address="0xa00" entry="true"/>
    <symbol name="vector_range"       address="0xb00" entry="true"/>
    <symbol name="vector_syscall"     address="0xc00" entry="true"/>
    <symbol name="vector_fp"          address="0xd00" entry="true"/>
    <symbol name="vector_trap"        address="0xe00" entry="true"/>
  </default_symbols>
  <default_memory_blocks>
    <!-- Created uninitialized and writable, so the decompiler treats loads as
         ordinary memory. The data RAM contents are placed at runtime by sBoot,
         so an import has nothing to fill them with yet. -->
    <!-- Starts at 0x200000, not 0: with the low 2 MB mapped, every small
         constant, struct offset and stack adjustment became a data reference
         (20,359 below 0x10000 on stream 0, 3,755 more below 0x200000, e.g.
         99999 = 0x1869f). The data seen in use starts near 0x2ce000. -->
    <memory_block name="data_ram" start_address="data:0x00200000" length="0x1ae00000"
                  initialized="false" mode="rw"/>
    <!-- No MMIO block: registers are not reached by address. The firmware
         passes a register number (e.g. 0x121b00, bank 0x121b) to helpers such
         as FUN_0036ab4f, which write to base + (n*2 - (n&1)). The base is a
         pointer in data RAM (data:0x3af750 on stream 0) that the image only
         reads, so where the registers live is set outside it. Mapping the
         register numbers as memory would turn every one into a false data
         reference. -->
  </default_memory_blocks>
  <context_data>
    <tracked_set space="ram">
      <!-- r0 is hardwired to zero (verified in aeon-elf-sim). -->
      <set name="r0" val="0"/>
    </tracked_set>
  </context_data>
</processor_spec>
